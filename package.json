{
  "name": "chambaz.tech",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "css": "tailwindcss -i styles/site.css -o static/css/site.css --minify",
    "js": "esbuild scripts/life/index.js --bundle --format=esm --splitting --minify --outdir=static/js/generated --entry-names=life",
    "assets": "npm run css && npm run js",
    "build": "npm run assets && zola build",
    "dev": "npm run assets && concurrently --kill-others \"tailwindcss -i styles/site.css -o static/css/site.css --watch\" \"npm run js -- --watch\" \"zola serve --interface 0.0.0.0 --port 5173 --drafts --extra-watch-path data --output-dir .preview --force\"",
    "preview": "npm run assets && zola serve --interface 0.0.0.0 --port 5173 --output-dir .preview --force",
    "check": "npm run assets && zola check",
    "lint": "oxlint static/js/site.js static/js/theme.js scripts tests playwright.config.js",
    "test": "npm run build && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
